# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to source control — it is gitignored.

project_name        = "costwatch"
environment         = "dev"
aws_region          = "us-east-1"
instance_type       = "t3.small"
root_volume_size_gb = 20
db_instance_class   = "db.t4g.micro"
db_storage_gb       = 20

# db_password must be set via TF_VAR_db_password environment variable.
# Example (PowerShell):
#   $env:TF_VAR_db_password = "YourSecurePassword123!"
