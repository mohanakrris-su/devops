# CostWatch Backend Configuration

# Server
PORT=4000
NODE_ENV=development

# Data Mode: "mock" (default) or "mongodb"
DATA_MODE=mock

# MongoDB (only needed when DATA_MODE=mongodb)
MONGODB_URI=mongodb://localhost:27017/costwatch

# Anomaly Detection Thresholds
ANOMALY_PERCENTAGE_THRESHOLD=50
ANOMALY_ABSOLUTE_THRESHOLD=50
ANOMALY_HISTORY_DAYS=14

# Alert Configuration
ALERT_DEDUP_WINDOW_HOURS=24
